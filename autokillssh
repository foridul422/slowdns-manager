#!/bin/bash
# ====================================================================
# Script: autokillssh - Multi-login Limiter & Auto Expire Cleaner
# ====================================================================

# 1. Enforce Multi-Login Limit
declare -A USER_PIDS
while read -r pid user; do
    if [ -n "$user" ] && [ "$user" != "root" ] && [ "$user" != "sshd" ]; then
        USER_PIDS["$user"]+="$pid "
    fi
done < <(ps -ef | grep 'sshd: ' | grep -v 'sshd: \[priv\]' | awk '{print $2, $1}')

for user in "${!USER_PIDS[@]}"; do
    pids=(${USER_PIDS["$user"]})
    count=${#pids[@]}
    limit=1
    if [ -f "/etc/slowdns/users/$user.conf" ]; then
        limit=$(grep "MAX_LOGIN=" "/etc/slowdns/users/$user.conf" | cut -d'"' -f2)
        [ -z "$limit" ] && limit=1
    fi

    if [ "$count" -gt "$limit" ]; then
        excess=$((count - limit))
        # Kill newest excess connections
        for ((i=limit; i<count; i++)); do
            kill -9 "${pids[$i]}" &>/dev/null
        done
        echo "$(date): Killed $excess excess sessions for user $user (Limit: $limit)" >> /var/log/slowdns-autokill.log
    fi
done

# 2. Delete Expired Accounts
TODAY=$(date +%s)
while IFS=: read -r user pass uid gid comment home shell; do
    if [ "$shell" = "/bin/false" ] || [ "$shell" = "/usr/sbin/nologin" ]; then
        if [ "$uid" -lt 1000 ] && [ "$user" != "vpn" ]; then
            continue
        fi

        EXP_RAW=$(chage -l "$user" 2>/dev/null | grep "Account expires" | awk -F": " '{print $2}')
        if [ "$EXP_RAW" != "never" ] && [ -n "$EXP_RAW" ]; then
            EXP_SEC=$(date -d "$EXP_RAW" +%s 2>/dev/null)
            if [ -n "$EXP_SEC" ] && [ "$EXP_SEC" -lt "$TODAY" ]; then
                pkill -u "$user" &>/dev/null
                userdel -f "$user" &>/dev/null
                rm -f "/etc/slowdns/users/$user.conf"
                echo "$(date): Auto-deleted expired account $user" >> /var/log/slowdns-autokill.log
            fi
        fi
    fi
done < /etc/passwd
